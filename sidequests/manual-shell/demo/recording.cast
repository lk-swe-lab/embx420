[31.531724, "o", "\r\n$ ./Unix_Shell (one foreground session; % lines are inputs)\r\n"]
[31.532332, "o", "\r\n% pwd --help\r\n"]
[31.54473, "o", "Usage: pwd [-hP] [--json]\r\n\r\n  -h, --help           Show help and exit.\r\n  -P, --physical       Print physical directory (the default).\r\n  --json               Emit a UTF-8 JSON cwd object.\r\n\r\nPrint the physical current directory; ignore environment PWD.\r\nExit status: 0 success, 1 I/O/encoding failure, 2 argument error.\r\n"]
[36.535086, "o", "\r\n% cat --help\r\n"]
[36.536462, "o", "Usage: cat [-hn] [FILE]...\r\n\r\n  -h, --help           Show help and exit.\r\n  -n, --number         Number every output line.\r\n  FILE                 Input files in order; '-' means stdin.\r\n\r\nNo files: read stdin. Use -- before dash-prefixed filenames.\r\nExit status: 0 success, 1 I/O failure, 2 argument error.\r\n"]
[41.537605, "o", "\r\n% head --help\r\n"]
[41.539029, "o", "Usage: head [-h] [-n N] [-n N] [--json] [FILE]\r\n\r\n  -h, --help           Show help and exit.\r\n  -n, --lines=N        First N lines; unsigned decimal, default 10.\r\n  --json               Emit path and lines as UTF-8 JSON.\r\n  FILE                 Input file; '-' means stdin.\r\n\r\nNo FILE reads stdin. Use -- before dash-prefixed filenames.\r\nExit status: 0 success, 1 I/O/encoding failure, 2 argument error.\r\n"]
