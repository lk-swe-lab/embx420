lse:got={'absent':True}\n  observed[n]=got\n  if got!=v:differences.append(n)\n result.update(fixed_inventory=len(inventory),preservation_differences=differences,head=subprocess.check_output(['git','rev-parse','HEAD'],cwd=REPO).decode().strip(),index_empty=not subprocess.check_output(['git','diff','--cached','--name-only'],cwd=REPO))\n (BASE/'preservation-after.json').write_text(json.dumps(observed,indent=2)+'\\n');(BASE/'audit.json').write_text(json.dumps(result,indent=2)+'\\n')\n print(json.dumps(result,indent=2));assert not differences;assert result['head']==HEAD and result['index_empty']\n\ndef mutants():\n root=BASE/'normal';flags=['-std=c17','-Wall','-Wextra','-g3','-O0','-Isrc','-Ibuild/argtable3/include'];lib=['-Lbuild/argtable3/lib','-largtable3','-lm'];wrap=['-Wl,--wrap=arg_lit0,--wrap=arg_str0,--wrap=arg_strn,--wrap=arg_end,--wrap=arg_parse,--wrap=write']\n for name in ['no-output','no-preflight','no-getopt-restore','borrowed-argv']:\n  source=BASE/(name+'.c');source.write_bytes((IMPL/(name+'.c')).read_bytes());output=BASE/name\n  if name in ['no-output','no-preflight']:\n   assert run('compile-'+name,['cc',*flags,'src/printf_main.c',str(source),'src/cmd_lines.c',*lib,'-o',str(output)],root).returncode==0\n   selector='--smoke' if name=='no-output' else '--preflight-only'\n   p=run('negative-'+name,['python3',str(BASE/'printf_review.py'),str(root),'--binary',str(output),selector],root,expected=1)\n   marker=b'PRINTF_REVIEW_BYTES' if name=='no-output' else b'PRINTF_REVIEW_PREFLIGHT';assert p.returncode==1 and marker in p.stderr\n  else:\n   obj=BASE/(name+'.o');assert run('compile-'+name,['cc',*flags,'-Dmalloc=printf_test_malloc','-Dfree=printf_test_free','-c',str(source),'-o',str(obj)],root).returncode==0\n   assert run('link-'+name,['cc',*flags,'tests/test_printf_module.c',str(obj),'src/cmd_lines.c',*wrap,*lib,'-o',str(output)],root).returncode==0\n   p=run('negative-'+name,[str(output),'--argv-only'] if name=='borrowed-argv' else [str(output)],root,expected=-6)\n   assert p.returncode==-6 and (b'PRINTF_ARGV_POINTER' if name=='borrowed-argv' else b'PRINTF_GETOPT') in p.stderr\n assert run('unchanged-module-green',['./build/test_printf_module'],root).returncode==0\n assert run('unchanged-own-oracle-green',['python3',str(BASE/'printf_review.py'),str(root)],root).returncode==0\nif __name__=='__main__':\n if sys.argv[1]=='audit':audit()\n else:mutants()\n"
