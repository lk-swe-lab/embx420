  "scripts": {
    "negatives.py": "#!/usr/bin/env python3\n\"\"\"Fresh scratch-only behavioral mutants; require defect-specific markers.\"\"\"\nimport os\nfrom pathlib import Path\nimport subprocess\nBASE = Path(__file__).resolve().parent\nROOT = Path.cwd()\nsource = (ROOT / 'src/cmd_date.c').read_text()\nflags = ['-std=c17', '-Wall', '-Wextra', '-Wpedantic', '-Wformat=2', '-g3', '-O0',\n         '-Isrc', '-Ibuild/argtable3/include']\nwrap = '-Wl,--wrap=arg_lit0,--wrap=arg_end,--wrap=arg_parse,--wrap=write,' + \\\n       '--wrap=clock_gettime,--wrap=gmtime_r,--wrap=localtime_r,--wrap=snprintf'\nvariants = [\n    ('utc-ignored', 'emit(((struct arg_lit *)table[UTC])->count != 0)',\n     'emit(0)', b'DATE_OUTPUT_LENGTH'),\n    ('caller-argv', 'arg_parse(argc, copy, table)',\n     'arg_parse(argc, argv, table)', b'DATE_ARGV_POINTER'),\n    ('getopt-state', 'optind = saved_optind;',\n     '(void)saved_optind;', b'DATE_GETOPT'),\n    ('bad-calendar', 'calendar.tm_mon < 0 || calendar.tm_mon > 11 ||',\n     '0 ||', b'DATE_STATUS'),\n    ('output-ignored', 'return lines_write((const unsigned char *)output, (size_t)length);',\n     '(void)lines_write((const unsigned char *)output, (size_t)length);\\n    return 0;',\n     b'DATE_STATUS'),\n]\nfor name, old, new, marker in variants:\n    assert source.count(old) == 1\n    mutant = BASE / (name + '.c')\n    mutant.write_text(source.replace(old, new))\n    obj = BASE / (name + '.o')\n    binary = BASE / name\n    compile_cmd = ['cc', *flags, '-Dmalloc=date_test_malloc', '-Dfree=date_test_free',\n                   '-c', str(mutant), '-o', str(obj)]\n    link_cmd = ['cc', *flags, 'tests/test_date_module.c', str(obj),\n                'src/cmd_lines.c', wrap, '-Lbuild/argtable3/lib', '-largtable3',\n                '-lm', '-o', str(binary)]\n    for command in [compile_cmd, link_cmd]:\n        r = subprocess.run(command, capture_output=True, timeout=30)\n        print('COMMAND', command, 'STATUS', r.returncode)\n        print(r.stdout.decode(errors='backslashreplace'))\n        print(r.stderr.decode(errors='backslashreplace'))\n        assert r.returncode == 0, 'mutant setup failure'\n    r = subprocess.run([str(binary)], capture_output=True, timeout=30)\n    print('RUN', name, 'STATUS', r.returncode, 'STDOUT', repr(r.stdout),\n          'STDERR', repr(r.stderr))\n    assert r.returncode != 0 and marker in r.stderr, (name, marker, r)\nprint('Five genuine behavioral mutants rejected with intended markers.')\n"
  },
